{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    // packages/core imports with explicit .ts extensions so the same sources
    // also run under `node --experimental-strip-types` for the engine tests.
    "allowImportingTsExtensions": true,
    // vite/client declares the `?worker` import suffix
    "types": ["vite/client"],
    "paths": {
      "@bulksift/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/core/src"]
}
