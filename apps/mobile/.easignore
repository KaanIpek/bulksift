# What EAS Build uploads. Present only because .gitignore is the wrong list for
# this job.
#
# The card index and price book are deliberately NOT tracked in git - they are
# build artifacts, regenerated by tools/. But EAS uses .gitignore to decide what
# to send when no .easignore exists, so the first cloud build shipped without
# them and `expo export:embed` died resolving require('../assets/data/index.bin').
# This file exists to keep assets/data in the upload while still leaving out
# everything that genuinely does not belong.

node_modules/

# Generated by `expo prebuild` on the build machine itself.
android/
ios/

# Dev-only self-test frames: 6 MB that release builds never execute.
assets/dev/

.expo/
*.log
.DS_Store
