# --- dependencies and build output -------------------------------------------
node_modules/
dist/
.expo/
apps/mobile/android/
apps/mobile/ios/
apps/web/dist/

# --- generated data ------------------------------------------------------------
# The card images are ~4 GB and are only ever inputs to the index build. The
# built artifacts they produce (index.bin, cards.json, prices.json) ARE tracked,
# because CI needs them to assemble the app and cannot re-download 20k images.
data/images/
data/cache/
data/catalogue.json
data/missing_images.json
data/set_match_report.json
data/*.log

# The web app's copy is served from disk at dev time and can be regenerated.
apps/web/public/data/

# The mobile copies CANNOT be ignored: EAS uploads what git tracks, and
# .easignore can only exclude further - it cannot re-include an ignored file.
# A build without these dies in `expo export:embed` resolving the index.
# So apps/mobile/assets/data and apps/mobile/src/core are tracked on purpose.

# --- test fixtures --------------------------------------------------------------
# Hundreds of MB of raw frames, regenerated by tools/export_*_fixtures.py
packages/core/test/fixtures/*.bin
packages/core/test/fixtures/*.json
apps/web/public/dev-fixtures/
apps/mobile/assets/dev/

# --- research ---------------------------------------------------------------------
research/images/
research/images_all/
research/images_hires/
research/*.log
research/*.zip
research/__pycache__/
__pycache__/

# --- credentials ------------------------------------------------------------------
# Apple keys are referenced by path or injected as CI secrets, never committed.
*.p8
*.jks
*.keystore
*.mobileprovision
*.p12
.env
.env.*
research/sample_meta.json
packages/core/native/*.exe
packages/core/native/*.obj
