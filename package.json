{
  "name": "frontline-td",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontline — mobile tower-defense / territory-capture strategy game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "test:browser": "npm run build && node scripts/smoke.mjs",
    "balance": "vite-node scripts/balance-campaign.ts",
    "ladder": "vite-node scripts/ladder.ts",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  }
}
